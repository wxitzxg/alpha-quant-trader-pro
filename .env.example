# 环境变量配置示例
# Environment variables example

# ========== 应用配置 ==========
# Application configuration
APP_ENV=development                  # 运行环境: development, testing, production
DEBUG=false                          # 调试模式
TZ=Asia/Shanghai                     # 时区

# ========== 数据库配置 ==========
# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_market
# 也可以使用嵌套格式覆盖特定字段:
# DATABASE__POOL_SIZE=20
# DATABASE__MAX_OVERFLOW=30

# ========== Redis配置 (可选) ==========
# Redis configuration (optional)
REDIS_URL=redis://localhost:6379/0

# ========== 日志配置 ==========
# Logging configuration
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========== API服务器配置 ==========
# API server configuration
API_SERVER__HOST=0.0.0.0
API_SERVER__PORT=8000

# ========== 回测配置 (可选) ==========
# Backtest configuration (optional)
# BACKTEST__START_DATE=2023-01-01
# BACKTEST__END_DATE=2024-12-31
# BACKTEST__INITIAL_CAPITAL=100000

# ========== 其他配置 ==========
# Other configuration
# 可以使用嵌套格式覆盖任何配置字段
# 格式: {SECTION}__{FIELD} (注意是双下划线)
#
# 示例:
# FEE__STAMP_DUTY=0.001
# FEE__BROKER_COMMISSION=0.0003
# STOCK_MARKET__SYNC__INTERVAL=600

# ========== 数据库配置说明 ==========
# Database configuration documentation
#
# 开发环境 / Development:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_market
#
# 测试环境 / Testing:
#   DATABASE_URL=postgresql://postgres:postgres_test@test-db:5432/test_stock_market
#
# 生产环境 / Production:
#   DATABASE_URL=postgresql://alpha_quant:your_secure_password@prod-host:5432/alpha_quant
#
# 注意事项 / Notes:
# - 密码中包含特殊字符时需要用引号包裹 / Use quotes if password contains special characters
# - 不要将包含真实密码的 .env 文件提交到 Git / Never commit .env with real passwords
# - 使用 .env.example 作为模板 / Use .env.example as template
# - 嵌套配置使用双下划线 / Nested config uses double underscore:
#   DATABASE__POOL_SIZE=20
#   DATABASE__MAX_OVERFLOW=30
